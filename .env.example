# Flask secret key for JWT signing
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_use_a_long_random_string

# Admin password hash
# Generate with: python3 scripts/set_password.py
ADMIN_PASSWORD_HASH=change_me_run_set_password_py

# RCON password — must match rcon.password in server.properties
RCON_PASSWORD=change_me_set_rcon_password

# Optional overrides (defaults shown below)
# RCON_HOST=127.0.0.1
# RCON_PORT=25575
# MODS_DIR=/opt/fabric/mods
# MOD_STASH_DIR=/opt/fabric/mod_stash
# LOG_PATH=/opt/fabric/logs/latest.log
# WORLD_ACTIVE_DIR=/opt/fabric/world
# WORLD_INACTIVE_DIR=/opt/fabric/world.inactive
# SERVICE_NAME=minecraft-fabric.service
# MAX_UPLOAD_MB=150
