[Unit]
Description=Minecraft Web Admin Interface
After=network.target

[Service]
Type=simple
User=mcwebadmin
Group=mcwebadmin
WorkingDirectory=/home/minecraft/mcwebadmin
EnvironmentFile=/home/minecraft/mcwebadmin/.env

# gevent-websocket worker required for Flask-SocketIO
ExecStart=/home/minecraft/mcwebadmin/.venv/bin/gunicorn \
    --worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker \
    --workers 1 \
    --bind 0.0.0.0:8080 \
    --access-logfile - \
    --error-logfile - \
    run:app

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
